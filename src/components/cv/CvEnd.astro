---
// End card (noir): "One person. Whole pipeline." Get in touch (mailto), Download CV, back to the works index.
import Pill from '../ui/Pill.astro';
import EditorialLink from '../ui/EditorialLink.astro';
import { t, FACTS, type Lang } from '../../lib/i18n';
import { withBase, routePath } from '../../lib/paths';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const e = t(lang).cv.end;
const c = t(lang);
---
<section id="end" class="band end" data-theme="noir" aria-labelledby="end-title">
  <p class="end__kicker t-label">{e.kicker}</p>
  <h2 id="end-title" class="end__title t-display" data-reveal="lines">{e.headline[0]} <br />{e.headline[1]}</h2>
  <div class="end__cta">
    <Pill href={c.contact.channels.email.href}>{e.cta}</Pill>
    <Pill variant="outline" href={withBase(FACTS.cvPdf.path)} download={FACTS.cvPdf.downloadName}>{e.cv}</Pill>
  </div>
  <EditorialLink class="t-nav end__work" href={withBase(routePath(lang)) + '#work'}>{e.selectedWork}</EditorialLink>
</section>

<style>
  .end {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-3);
    min-height: min(80svh, 720px);
    padding-inline: var(--space-container);
    background: var(--color-noir);
    color: var(--color-cotton);
    --ring-ground: var(--color-noir);
  }
  .end__kicker {
    color: var(--color-gray-on-noir);
  }
  .end__title {
    color: var(--color-cotton);
  }
  .end__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .end :global(.end__work) {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }
</style>
