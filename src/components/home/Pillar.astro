---
// One pillar: portrait (4:5 desktop, 4:3 phone), cherry index, Newsreader title, Inter body.
// The portrait is the P1-P3 file when it exists at build time, else a token-coloured block with the exact aspect.
import { t, type Lang } from '../../lib/i18n';
import { portrait } from './media';

interface Props {
  lang: Lang;
  id: 'engineer' | 'orchestrate' | 'design';
}
const { lang, id } = Astro.props;
const p = t(lang).capability.pillars[id];
const img = portrait(id);
---
<article class="pillar">
  <div class="pillar__media" data-reveal="block">
    {img
      ? (
        <picture>
          {img.phone && <source media="(max-width: 959px)" srcset={img.phone} />}
          <img src={img.src} alt={p.portraitAlt} width="1200" height="1500" loading="lazy" decoding="async" />
        </picture>
      )
      : <div class="pillar__ph" aria-hidden="true"></div>}
  </div>
  <p class="pillar__idx t-label">{p.index}</p>
  <h3 class="pillar__title t-card-title" data-reveal="lines">{p.title}</h3>
  <p class="pillar__body t-small">{p.body}</p>
</article>

<style>
  .pillar {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }
  .pillar__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--color-hairline);
    margin-bottom: var(--space-2);
  }
  .pillar__media picture,
  .pillar__media img,
  .pillar__ph {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pillar__idx {
    color: var(--red-cherry);
  }
  .pillar__title {
    color: var(--color-ink);
  }
  .pillar__body {
    max-width: var(--measure-small);
    color: var(--color-ink);
  }
  @media (min-width: 960px) {
    .pillar__media {
      aspect-ratio: 4 / 5;
    }
  }
</style>
