---
// Section #work: board C. Kicker row, H2, intro, then one <ol> of six WorkRows.
// Fine pointer >= 960 px: ruled rows + the shared float frame (src/scripts/works/float-preview.ts, armed through
// data-float). Everywhere else: the same list as a poster carousel with scroll-snap.
import WorkRow from './WorkRow.astro';
import { works } from '../../lib/works';
import { t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const w = t(lang).works;
const list = works(lang);
---
<section id="work" class="band works" data-works data-float="off" aria-labelledby="work-title">
  <p class="works__kicker t-label">
    <span>{w.kicker}</span>
    <span>{w.location}</span>
  </p>
  <div class="works__head">
    <h2 id="work-title" class="t-display" data-reveal="lines">{w.title}</h2>
    <p class="works__intro t-subhead">{w.intro}</p>
  </div>
  <ol class="works__list" data-works-list>
    {list.map((work) => <WorkRow work={work} lang={lang} />)}
  </ol>
</section>

<style>
  .works {
    padding-top: var(--space-4);
  }
  .works__kicker {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-gray);
  }
  .works__head {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5) var(--space-4);
  }
  .works__intro {
    max-width: var(--measure-lede);
    color: var(--color-ink);
  }
  @media (min-width: 960px) {
    .works__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      column-gap: var(--gutter);
    }
  }

  /* carousel (default) */
  .works__list {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--space-2);
    scroll-padding-inline: var(--gutter);
  }
  /* board C rows */
  @media (min-width: 960px) and (hover: hover) and (pointer: fine) {
    .works__list {
      display: block;
      overflow: visible;
      scroll-snap-type: none;
      margin-inline: 0;
      padding: 0;
    }
  }
</style>

<!-- The float frame is created by the script and lives on <body>, so its styles must be global. -->
<style is:global>
  .wfloat {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 90;
    width: var(--float-w);
    height: calc(var(--float-w) * 1.25); /* 320 x 400, 4:5 like the 960 x 1200 films */
    border-radius: var(--radius-media);
    overflow: hidden;
    pointer-events: none;
    background: var(--color-noir);
    will-change: transform, clip-path;
  }
  .wfloat__poster,
  .wfloat__film {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the show-layer: the film is lit only by the generation that started it (float-preview.ts) */
  .wfloat__film {
    opacity: 0;
  }
  .wfloat[data-film='on'] .wfloat__film {
    opacity: 1;
  }
</style>
