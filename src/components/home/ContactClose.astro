---
// Section #contact (noir): two-line headline, body, cherry pill (mailto) + outline pill (CV PDF), status line and
// exactly four channel rows on rule-on-noir hairlines. No form.
import Pill from '../ui/Pill.astro';
import { t, FACTS, type Lang } from '../../lib/i18n';
import { withBase } from '../../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).contact;
const channels = Object.entries(c.channels) as [string, { label: string; value: string; href: string; aria?: string }][];
---
<section id="contact" class="band contact" data-theme="noir" aria-labelledby="contact-title">
  <div class="contact__main">
    <p class="contact__kicker t-label">{c.kicker}</p>
    <h2 id="contact-title" class="contact__title t-display" data-reveal="lines">{c.headline[0]} <br />{c.headline[1]}</h2>
    <p class="contact__body t-subhead">{c.body}</p>
    <div class="contact__cta">
      <Pill href={c.channels.email.href}>{c.cta}</Pill>
      <Pill variant="outline" href={withBase(FACTS.cvPdf.path)} download={FACTS.cvPdf.downloadName}>{c.cv}</Pill>
    </div>
    <p class="contact__status t-label">{c.status}</p>
  </div>
  <ul class="channels">
    {channels.map(([key, ch]) => {
      const mail = ch.href.startsWith('mailto:');
      return (
        <li class="channels__row">
          <a
            class="channel"
            href={ch.href}
            target={mail ? undefined : '_blank'}
            rel={mail ? undefined : 'noopener'}
            aria-label={ch.aria}
            data-channel={key}
            data-cursor="link"
          >
            <span class="channel__label t-label">{ch.label}</span>
            {ch.value !== ch.label && <span class="channel__value t-subhead">{ch.value}</span>}
            <span class="channel__arrow" aria-hidden="true"></span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .contact {
    display: grid;
    align-content: center;
    gap: var(--space-5) var(--gutter);
    min-height: min(100svh, 880px);
    background: var(--color-noir);
    color: var(--color-cotton);
    --ring-ground: var(--color-noir);
    padding-inline: var(--space-container);
  }
  .contact__main {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    justify-items: start;
  }
  .contact__kicker,
  .contact__status {
    color: var(--color-gray-on-noir);
  }
  .contact__title {
    color: var(--color-cotton);
  }
  .contact__body {
    max-width: var(--measure-lede);
    color: var(--color-cotton);
  }
  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .channels {
    border-top: 1px solid var(--rule-on-noir);
    align-self: end;
  }
  .channels__row {
    border-bottom: 1px solid var(--rule-on-noir);
  }
  .channel {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--row-channel);
    color: var(--color-cotton);
    text-decoration: none;
    transition: color var(--duration-nav-hover) var(--ease-out-sharp);
  }
  .channel__label {
    flex: 0 0 8.5em;
    color: inherit;
  }
  .channel__value {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--font-small);
    font-family: var(--font-family-ui);
    line-height: 1.3;
  }
  .channel__arrow {
    position: relative;
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    margin-left: auto;
  }
  /* CSS-drawn arrow (no glyph icons) */
  .channel__arrow::before,
  .channel__arrow::after {
    content: '';
    position: absolute;
    background: currentColor;
  }
  .channel__arrow::before {
    top: 0;
    right: 0;
    width: 14px;
    height: 1.5px;
  }
  .channel__arrow::after {
    top: 0;
    right: 0;
    width: 1.5px;
    height: 14px;
  }
  .channel:hover,
  .channel:focus-visible {
    color: var(--red-chili-300);
  }
  @media (min-width: 960px) {
    .contact {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }
</style>
