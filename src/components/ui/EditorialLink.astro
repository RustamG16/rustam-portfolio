---
// Editorial link: cherry on cotton (9.05:1), current colour on noir. 1px underline, 6px offset, always visible.
interface Props {
  href: string;
  external?: boolean;
  download?: string;
  class?: string;
}
const { href, external = false, download, class: cls = '' } = Astro.props;
---
<a
  class:list={['elink', cls]}
  href={href}
  download={download}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-cursor="link"
><slot /></a>

<style>
  .elink {
    color: var(--red-cherry);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: color var(--duration-nav-hover) var(--ease-out-sharp);
  }
  .elink:hover {
    color: var(--red-maroon);
  }
  :global([data-theme="noir"]) .elink {
    color: inherit;
  }
  :global([data-theme="noir"]) .elink:hover {
    color: var(--red-chili-300);
  }
</style>
