{
  "name": "rustam-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Rustam Gurbanov portfolio: RG x Convenium. Astro 5 static export.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "tokens": "node scripts/tokens-from-design.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs && astro build",
    "build:file": "node scripts/build-client.mjs && cross-env FILE_BUILD=1 astro build && node scripts/relativize.mjs dist-file",
    "preview": "astro preview",
    "serve": "node qa/serve.mjs dist 4181",
    "check": "node scripts/check-all.mjs"
  },
  "dependencies": {
    "astro": "5.18.2",
    "gsap": "3.15.0",
    "lenis": "~1.3.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.1.0",
    "puppeteer-core": "^25.0.0",
    "typescript": "^5.9.0"
  }
}
